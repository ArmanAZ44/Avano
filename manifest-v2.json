{
  "manifest_version": 2,
  "name": "آوانو | Avano — Real-time Video Dubbing",
  "version": "1.0.0",
  "description": "دوبله‌ی هم‌زمان و کم‌تأخیر ویدیوهای وب با Gemini Live API. همراه با زیرنویس دوطرفه و کنترل ترکیب صدای اصلی.",

  "browser_specific_settings": {
    "gecko": {
      "id": "avano@armanaz44.github.io",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["websiteContent"]
      }
    }
  },

  "permissions": [
    "activeTab",
    "storage",
    "tabs",
    "<all_urls>",
    "https://generativelanguage.googleapis.com/*"
  ],

  "background": {
    "page": "src/background/background-firefox.html",
    "persistent": true
  },

  "browser_action": {
    "default_title": "آوانو | Avano",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "assets/icon16.png",
      "32": "assets/icon32.png",
      "48": "assets/icon48.png",
      "128": "assets/icon128.png"
    }
  },

  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },

  "commands": {
    "_execute_browser_action": {
      "suggested_key": { "default": "Alt+Shift+A" }
    },
    "toggle-dubbing": {
      "suggested_key": { "default": "Alt+Shift+D" },
      "description": "شروع یا توقف دوبله"
    },
    "toggle-overlay": {
      "suggested_key": { "default": "Alt+Shift+O" },
      "description": "پنهان یا نمایان کردن پنل شناور"
    }
  },

  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["src/shared/browser-api.js", "src/content/content.js"],
      "css": ["src/content/content.css"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],

  "icons": {
    "16": "assets/icon16.png",
    "32": "assets/icon32.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  },

  "web_accessible_resources": [
    "assets/fonts/Vazirmatn.woff2",
    "assets/icon48.png",
    "assets/icon128.png",
    "src/offscreen/audio-worklets.js"
  ]
}
